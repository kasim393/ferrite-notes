{
  "name": "ferrite-notes-sync",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted sync server for Ferrite Notes (Cloudflare Worker + D1)",
  "license": "MIT",
  "author": "Kasim",
  "homepage": "https://github.com/kasim393/ferrite-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasim393/ferrite-notes.git"
  },
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply ferrite-notes --remote && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
